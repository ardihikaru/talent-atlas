# Copy this file to .env and fill in the two secrets.

# Root password of ArcadeDB, at least 8 characters. Generate one: openssl rand -hex 16
ARCADEDB_ROOT_PASSWORD=

# Signs the sign-in cookie, at least 32 characters. Generate one: openssl rand -hex 32
SESSION_SECRET=

# Port of the web app on this machine.
APP_PORT=8080

# Set to true when the app is served over HTTPS (behind a reverse proxy).
COOKIE_SECURE=false

TZ=Asia/Jakarta
