# Copy to .env and fill in. Never commit .env: this repo is public.

# --- ArcadeDB ---
# Local (profile local-db): keep the URL below, user root, any password >= 8 chars.
# Prod: http://10.10.0.5:2480, database talent_atlas, the dedicated talent_atlas user.
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_DATABASE=talent_atlas
ARCADEDB_USER=root
ARCADEDB_PASSWORD=

# --- Sessions --- at least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# --- Admin login --- created at boot, password re-applied when it changes (min 10 chars).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- HTTP ---
# Interface and port the app is published on. Prod: APP_BIND=10.10.0.4, APP_PORT=18201.
APP_BIND=127.0.0.1
APP_PORT=8080
# true when served over HTTPS (behind the nginx edge)
COOKIE_SECURE=false

TZ=Asia/Jakarta
